# Copy to .env.local. Never commit real values.

# --- Live mode switch -----------------------------------------------------------
# Live mode needs BOTH of these. Without them the app runs in preview mode: a bar on every
# page says all prices, balances and transactions are sample values (prd.md §0.5).
NEXT_PUBLIC_SOOTH_ADDRESS=
# DogeOS SDK clientId (OD-4). It must allow the app's origin (DECISIONS.md D-004).
NEXT_PUBLIC_DOGEOS_CLIENT_ID=
# Optional embedded wallet stage, if DogeOS gives you one for Sandbox vs Live
NEXT_PUBLIC_DOGEOS_STAGE=

# --- Price signers (server only, no NEXT_PUBLIC_ prefix) ---------------------------
# Five keys, comma-separated, one per exchange in lib/price.server.ts order (DECISIONS.md D-018).
# Create them with: node scripts/price-signers.mjs  (writes them here, prints addresses only)
PRICE_SIGNER_KEYS=
# DOGE value decimals from G0-1. Expected 8, UNVERIFIED.
NEXT_PUBLIC_PRICE_DECIMALS=8

# --- Contracts and chain ---------------------------------------------------------
NEXT_PUBLIC_VENUE_ADDRESS=
NEXT_PUBLIC_PAYOUT_TOKEN_ADDRESS=
# Block where Sooth was deployed, so event reads don't scan from genesis
NEXT_PUBLIC_SOOTH_DEPLOY_BLOCK=
# Explorer base URL, no trailing slash. If empty, the URL from the DogeOS chain list is used.
NEXT_PUBLIC_EXPLORER_URL=
# Gas limit for trigger, so a revert still lands on-chain with a hash (DECISIONS.md D-007)
NEXT_PUBLIC_TRIGGER_GAS_LIMIT=600000

# --- Verify page (prd.md §11, §14) -------------------------------------------------
NEXT_PUBLIC_DEMO_HOLDER=
# E-3, E-4, E-7 transaction hashes once recorded in evidence/chikyu
NEXT_PUBLIC_DEMO_TX_ABOVE_STOP=
NEXT_PUBLIC_DEMO_TX_BELOW_STOP=
NEXT_PUBLIC_DEMO_TX_AFTER_CANCEL=
